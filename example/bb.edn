;; bb start   the REPL agent (default), bundle compiled first if needed
;; bb bash    the bash agent with the canvas
;; bb build   compile the browser bundle (needs a JVM)
;; bb bench   what a server-pushed frame costs
;; bb jar     the example as one uberjar for babashka, target/rchat.jar
;; bb deploy <sprite>   the jar as a service on a sprites.dev sprite
;;
;; This file is EDN: no #(...) and no #"..." in here.
{:paths ["src" "resources"]
 :deps {io.github.simplemono/rchat$server {:local/root "../server"}}
 :tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :refer [shell]]
             [clojure.string :as str])

  :init
  (do
    (def bundle "resources/public/js/main.js")

    (defn mtime
      [path]
      (fs/file-time->millis (fs/last-modified-time path)))

    (defn newest-source-mtime
      "The newest modification time among what ends up in the bundle: the
      sources here and in the client module, and the deps."
      []
      (->> (concat (fs/glob "src" "**.cljs")
                   (fs/glob "../client/src" "**.cljs")
                   ["deps.edn" "../client/deps.edn" "shadow-cljs.edn"])
           (filter fs/exists?)
           (map mtime)
           (reduce max 0)))

    (defn stale?
      []
      (or (not (fs/exists? bundle))
          (< (mtime bundle) (newest-source-mtime))))

    (defn env-file
      "KEY=VALUE lines of .env here or in the repository root, quotes
      stripped, as the environment of the server. Values are not printed."
      []
      (into {}
            (for [file [".env" "../.env"]
                  :when (fs/exists? file)
                  line (str/split-lines (slurp file))
                  :let [line (str/trim (str/replace line (re-pattern "^export\\s+") ""))]
                  :when (and (seq line)
                             (not (str/starts-with? line "#"))
                             (str/includes? line "="))
                  :let [[k v] (str/split line (re-pattern "=") 2)]]
              [(str/trim k) (str/replace (str/trim v) (re-pattern "^[\"']|[\"']$") "")])))

    (defn serve
      [main-ns]
      (when (stale?)
        (println "The bundle is missing or older than the sources, compiling it first.")
        (run 'build))
      (let [env (env-file)]
        (when (seq env)
          (println (str "Read " (str/join ", " (keys env)) " from .env.")))
        (shell {:extra-env env} "bb" "-m" main-ns))))

  build
  {:doc "Compiles the browser bundle (needs a JVM and the clojure CLI)."
   :task (shell "clojure -M -m shadow.cljs.devtools.cli release browser")}

  start
  {:doc "The REPL agent at http://localhost:8080. Compiles the bundle first when it is missing or stale, reads .env."
   :task (serve "example.main")}

  bash
  {:doc "The bash agent with the canvas at http://localhost:8080."
   :task (serve "example.bash")}

  bench
  {:doc "Renders the scripted clip 600 times the way the server pushes it and prints the cost per frame."
   :task (shell {:extra-env {"RCHAT_MOTION" "server"}} "bb" "-m" "example.bench")}

  jar
  {:doc "The example and all its dependencies as target/rchat.jar, run with `bb target/rchat.jar`. Compiles the bundle first when stale."
   :task (do
           (when (stale?)
             (run 'build))
           (fs/create-dirs "target")
           (shell "bb" "uberjar" "target/rchat.jar" "-m" "example.main")
           (println (str "target/rchat.jar, " (quot (fs/size "target/rchat.jar") 1024) " kB")))}

  deploy
  {:doc "bb deploy <sprite>: the jar as the service `rchat` behind the sprite's URL. First time: installs babashka, pushes deploy/start.sh and the local .env (never over one on the sprite)."
   :task (let [sprite (or (first *command-line-args*)
                          (do (println "Which sprite? bb deploy <name>")
                              (System/exit 1)))
                remote (fn [script]
                         (str/trim (:out (shell {:out :string} "sprite" "exec" "-s" sprite "--" "bash" "-c" script))))
                push (fn [local remote-path]
                       (shell "sprite" "file" "push" "-s" sprite local remote-path))]
            (run 'jar)
            (println "Preparing" sprite)
            (remote "mkdir -p ~/rchat/work ~/.local/bin; if [ ! -x ~/.local/bin/bb ]; then cd ~ && curl -sLO https://raw.githubusercontent.com/babashka/babashka/master/install && chmod +x install && ./install --dir ~/.local/bin >/dev/null && rm -f install; fi; ~/.local/bin/bb --version")
            (push "deploy/start.sh" "/home/sprite/rchat/start.sh")
            (remote "chmod 700 ~/rchat/start.sh")
            (cond
              (= "yes" (remote "test -f ~/rchat/.env && echo yes || echo no"))
              (println "The sprite has its .env, kept.")

              (fs/exists? ".env")
              (do (push ".env" "/home/sprite/rchat/.env")
                  (remote "chmod 600 ~/rchat/.env")
                  (println "Pushed the local .env."))

              :else
              (println "No .env here or on the sprite: the agent starts without an API key. Put OPENROUTER_API_KEY=... into /home/sprite/rchat/.env on the sprite."))
            (push "target/rchat.jar" "/home/sprite/rchat/rchat.jar")
            (if (str/includes? (remote "sprite-env services list") "\"name\":\"rchat\"")
              (do (remote "sprite-env services restart rchat")
                  (println "Restarted the service rchat."))
              (do (remote "sprite-env services create rchat --cmd /home/sprite/rchat/start.sh --dir /home/sprite/rchat --http-port 8080 --no-stream")
                  (println "Created the service rchat.")))
            (println (remote "sleep 3; curl -s -o /dev/null -w 'The page answers %{http_code} on the sprite. ' http://127.0.0.1:8080/; tail -1 /.sprite/logs/services/rchat.log"))
            (shell "sprite" "info" "-s" sprite))}}}
